# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# runtime data (JSON créé par l'admin, seed en fallback)
data/*.json
!data/.gitkeep

# vidéo hero locale 106 Mo > limite GitHub 100 Mo (servie en dev ; en prod : poster + champ admin)
public/ORAN.mp4

# typescript
*.tsbuildinfo
next-env.d.ts
